(function(Scratch) {
    'use strict';
    
    // Ensure the extension has direct runtime access to modify Scratch's memory loop
    if (!Scratch.extensions.unsandboxed) {
        throw new Error('This extension must run unsandboxed!');
    }

    class AdvancedCloudLists {
        constructor() {
            // Global list storage shared across all sprites
            this.globalLists = {};
            // Local list storage isolated per sprite ID
            this.localLists = {};
            // Visibility monitoring trackers
            this.monitors = {};
        }

        getInfo() {
            return {
                id: 'advancedCloudLists',
                name: 'Pro Cloud Lists',
                color1: '#2b78e4',
                blocks: [
                    {
                        opcode: 'createCloudList',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'create cloud list [NAME] [SCOPE]',
                        arguments: {
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' },
                            SCOPE: {
                                type: Scratch.ArgumentType.STRING,
                                menu: 'scopeMenu',
                                defaultValue: 'for all sprites'
                            }
                        }
                    },
                    {
                        opcode: 'addToList',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'add [ITEM] to cloud list [NAME]',
                        arguments: {
                            ITEM: { type: Scratch.ArgumentType.STRING, defaultValue: 'thing' },
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    },
                    {
                        opcode: 'deleteIndex',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'delete [INDEX] of cloud list [NAME]',
                        arguments: {
                            INDEX: { type: Scratch.ArgumentType.NUMBER, defaultValue: 1 },
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    },
                    {
                        opcode: 'deleteItemValue',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'delete [ITEM] from cloud list [NAME]',
                        arguments: {
                            ITEM: { type: Scratch.ArgumentType.STRING, defaultValue: 'thing' },
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    },
                    {
                        opcode: 'deleteAll',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'delete all of cloud list [NAME]',
                        arguments: {
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    },
                    {
                        opcode: 'getItem',
                        blockType: Scratch.BlockType.REPORTER,
                        text: 'item [INDEX] of cloud list [NAME]',
                        arguments: {
                            INDEX: { type: Scratch.ArgumentType.NUMBER, defaultValue: 1 },
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    },
                    {
                        opcode: 'indexOfItem',
                        blockType: Scratch.BlockType.REPORTER,
                        text: 'item # of [ITEM] in cloud list [NAME]',
                        arguments: {
                            ITEM: { type: Scratch.ArgumentType.STRING, defaultValue: 'thing' },
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    },
                    {
                        opcode: 'getLength',
                        blockType: Scratch.BlockType.REPORTER,
                        text: 'length of cloud list [NAME]',
                        arguments: {
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    },
                    {
                        opcode: 'showList',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'show list [NAME]',
                        arguments: {
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    },
                    {
                        opcode: 'hideList',
                        blockType: Scratch.BlockType.COMMAND,
                        text: 'hide list [NAME]',
                        arguments: {
                            NAME: { type: Scratch.ArgumentType.STRING, defaultValue: 'highscores' }
                        }
                    }
                ],
                menus: {
                    scopeMenu: {
                        acceptReporters: false,
                        items: ['for all sprites', 'for this sprite only']
                    }
                }
            };
        }

        // Helper function to resolve the target list data pointer based on scope
        _getListRef(name, util) {
            const spriteId = util.target.id;
            if (this.localLists[spriteId] && this.localLists[spriteId][name]) {
                return this.localLists[spriteId][name];
            }
            if (this.globalLists[name]) {
                return this.globalLists[name];
            }
            return null;
        }

        createCloudList(args, util) {
            const name = args.NAME;
            if (args.SCOPE === 'for this sprite only') {
                const spriteId = util.target.id;
                if (!this.localLists[spriteId]) this.localLists[spriteId] = {};
                if (!this.localLists[spriteId][name]) this.localLists[spriteId][name] = [];
            } else {
                if (!this.globalLists[name]) this.globalLists[name] = [];
            }
            this._renderMonitor(args.NAME, util);
        }

        addToList(args, util) {
            const list = this._getListRef(args.NAME, util);
            if (list) {
                list.push(args.ITEM);
                this._renderMonitor(args.NAME, util);
            }
        }

        deleteIndex(args, util) {
            const list = this._getListRef(args.NAME, util);
            if (list) {
                const idx = Math.round(args.INDEX) - 1; // Converts Scratch 1-indexing to JS 0-indexing
                if (idx >= 0 && idx < list.length) {
                    list.splice(idx, 1);
                    this._renderMonitor(args.NAME, util);
                }
            }
        }

        deleteItemValue(args, util) {
            const list = this._getListRef(args.NAME, util);
            if (list) {
                const targetItem = String(args.ITEM).toLowerCase();
                // Iterates backwards so splicing elements doesn't break the index alignment loop
                for (let i = list.length - 1; i >= 0; i--) {
                    if (String(list[i]).toLowerCase() === targetItem) {
                        list.splice(i, 1);
                    }
                }
                this._renderMonitor(args.NAME, util);
            }
        }

        deleteAll(args, util) {
            const list = this._getListRef(args.NAME, util);
            if (list) {
                list.length = 0;
                this._renderMonitor(args.NAME, util);
            }
        }

        getItem(args, util) {
            const list = this._getListRef(args.NAME, util);
            if (!list) return '';
            const idx = Math.round(args.INDEX) - 1;
            return list[idx] !== undefined ? list[idx] : '';
        }

        indexOfItem(args, util) {
            const list = this._getListRef(args.NAME, util);
            if (!list) return 0;
            const target = String(args.ITEM).toLowerCase();
            for (let i = 0; i < list.length; i++) {
                if (String(list[i]).toLowerCase() === target) return i + 1; // Scratch items start at 1
            }
            return 0; // 0 means item not found in list
        }

        getLength(args, util) {
            const list = this._getListRef(args.NAME, util);
            return list ? list.length : 0;
        }

        showList(args, util) {
            this.monitors[args.NAME] = true;
            this._renderMonitor(args.NAME, util);
        }

        hideList(args, util) {
            this.monitors[args.NAME] = false;
            this._renderMonitor(args.NAME, util);
        }

        // Handles redrawing requirements inside the application frame loop
        _renderMonitor(name, util) {
            util.runtime.requestRedraw();
            const list = this._getListRef(name, util);
            if (list && this.monitors[name]) {
                console.log(`[Cloud List Monitor] ${name}: `, JSON.stringify(list));
            }
        }
    }

    Scratch.extensions.register(new AdvancedCloudLists());
})(Scratch);
